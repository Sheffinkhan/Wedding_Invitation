{
  "name": "wedding-invitation",
  "version": "0.1.0",
  "private": true,
  "description": "Digital wedding invitation with guest wishes and an editor",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
